# Database
DATABASE_URL=postgresql://user:pass@host:5432/voice_agent

# LiveKit
LIVEKIT_URL=wss://your-livekit-server.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SIP / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRUNK_DOMAIN=
SIP_OUTBOUND_TRUNK_ID=

# LLM provider (one of)
OPENAI_API_KEY=
SARVAM_API_KEY=
BOLNA_API_KEY=
RETELL_API_KEY=

# Shopify (if using the order-confirm flow)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=

# Webhook receiver
HTTP_PORT=8081

# Purity voice quality defaults (all optional; engine has safe defaults)
# Sarvam is the default Indian-language TTS path for this deployment.
TTS_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_HI_SPEAKER=shubh
SARVAM_EN_SPEAKER=ratan
SARVAM_PA_SPEAKER=mani
TTS_PACE=1.05
TTS_SAMPLE_RATE=8000
TTS_TEMPERATURE=0.55

# LiveKit agent controls
DEFAULT_AGENT_PROFILE=purity-coffee-b2b
